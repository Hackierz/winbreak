{
  "name": "winbreak",
  "version": "0.1.0",
  "description": "Finds the code in a Node project that works on macOS and Linux but breaks on Windows. Zero dependencies.",
  "keywords": [
    "windows",
    "cross-platform",
    "spawn",
    "EINVAL",
    "ENOENT",
    "portability",
    "lint",
    "ci"
  ],
  "license": "MIT",
  "author": "OpusMill (https://opusmill.com)",
  "homepage": "https://opusmill.com",
  "type": "commonjs",
  "bin": {
    "winbreak": "bin/cli.js"
  },
  "main": "lib/scan.js",
  "files": [
    "bin",
    "lib",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run.js",
    "build:web": "node scripts/build-web.js",
    "prepublishOnly": "node scripts/build-web.js && node test/run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hackierz/winbreak.git"
  },
  "bugs": {
    "url": "https://github.com/Hackierz/winbreak/issues"
  }
}
