{
  "name": "pkg-broken",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production node build.js",
    "clean": "rm -rf dist",
    "greet": "node -e \"console.log(1)\" && echo $HOME",
